{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "파일 열기 대화상자와 음악 파일 읽기(읽기 전용) 권한. 쓰기·네트워크 권한 없음.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "fs:allow-read-file",
    "fs:allow-read-dir",
    "fs:allow-stat",
    {
      "identifier": "fs:scope",
      "allow": [{ "path": "**" }]
    }
  ]
}
